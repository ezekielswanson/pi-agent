# Sample configuration only. Do not put real secrets in this file.
PORT=8787
MCP_ISSUER=http://127.0.0.1:8787
MCP_RESOURCE_URL=http://127.0.0.1:8787/mcp
MCP_AUTH_SECRET=replace-with-a-long-random-string
MCP_APPROVAL_SECRET=replace-with-a-different-long-random-string
HUBSPOT_TOKEN_KEY=replace-with-32-byte-base64
HUBSPOT_TOKEN_FILE=data/hubspot-grants.json
MCP_REVOCATION_FILE=data/revocations.json
HUBSPOT_PORTAL_ID=5627913
HUBSPOT_API_MCP_USERS=replace-with-approved-user-ids
# JSON array of {id, passwordHash}. Hashes come from hashPassword(); do not store plaintext passwords.
HUBSPOT_API_MCP_USERS_JSON=[]
MCP_CLIENTS_JSON=[{"clientId":"local-pi","redirectUris":["http://127.0.0.1:8788/callback","https://claude.ai/api/mcp/auth_callback","https://chatgpt.com/connector_platform_oauth_redirect"],"publicClient":true}]
HUBSPOT_API_CLIENT_ID=
HUBSPOT_API_CLIENT_SECRET=
HUBSPOT_API_REDIRECT_URI=http://127.0.0.1:8787/hubspot/oauth/callback
# read-only or writes-with-approval. Delete, archive, and purge stay denied in this release.
HUBSPOT_ACTION_POLICY=read-only
# deny or approval. Export creation is separate from read-only reads.
HUBSPOT_EXPORT_CREATION=deny
