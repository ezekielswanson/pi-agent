{
  "name": "pi-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared local Pi agent for HubSpot, Notion, Asana, and one external system",
  "scripts": {
    "smoke:client": "tsx scripts/smoke-client.ts",
    "smoke:notion": "tsx scripts/smoke-notion.ts",
    "smoke:asana": "tsx scripts/smoke-asana.ts",
    "smoke:external": "tsx scripts/smoke-external.ts",
    "smoke:hubspot": "tsx scripts/smoke-hubspot.ts",
    "smoke:hubspot:live": "tsx scripts/smoke-hubspot-live.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@notionhq/client": "^5.4.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typebox": "1.3.7",
    "typescript": "^5.9.2",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "pi-mcp-adapter": "2.34.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
